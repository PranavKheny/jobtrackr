# -----------------------------------------------------------------------------
# Supabase
#
# Get these from your Supabase project dashboard in the API settings.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Database
#
# This should be the connection string for your PostgreSQL database.
# If using Supabase, you can get this from the database settings.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# -----------------------------------------------------------------------------
# API
#
# The base URL for the backend API.
# This should be the URL of your deployed API service (e.g., on Render).
# For local development, this is typically http://localhost:3001.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Demo Mode
#
# Set to "true" to enable read-only demo mode.
# In demo mode, write operations (POST, PUT, DELETE) are disabled.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_MODE=false
DEMO_MODE=false

# -----------------------------------------------------------------------------
# Web App
#
# The URL of the deployed web application (e.g., on Vercel).
# This is used by the backend for CORS configuration.
# -----------------------------------------------------------------------------
WEB_APP_URL=http://localhost:3000
